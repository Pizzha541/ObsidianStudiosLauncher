{
  "name": "obsidian-launcher",
  "version": "1.1.0",
  "description": "Launcher de Obsidian Studios",
  "productName": "Obsidian Studios Launcher",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "check": "node --check main.js && node --check preload.js && node --check src/renderer.js",
    "test:smoke": "node scripts/smoke-test.js",
    "test:visual": "electron scripts/ui-visual-test.js",
    "audit:prod": "npm audit --omit=dev",
    "content:validate": "node scripts/content-tool.js validate",
    "content:hash": "node scripts/content-tool.js hash",
    "content:admin": "node scripts/content-admin-server.js",
    "dist": "electron-builder --win nsis --publish never",
    "dist:dir": "electron-builder --win dir --publish never"
  },
  "keywords": [],
  "author": "Pizzha",
  "license": "MIT",
  "type": "commonjs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Pizzha541/ObsidianStudiosLauncher.git"
  },
  "bugs": {
    "url": "https://github.com/Pizzha541/ObsidianStudiosLauncher/issues"
  },
  "homepage": "https://github.com/Pizzha541/ObsidianStudiosLauncher#readme",
  "build": {
    "appId": "com.obsidianstudios.launcher",
    "productName": "Obsidian Studios Launcher",
    "artifactName": "Obsidian-Studios-Launcher-Setup-${version}.${ext}",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "data/**/*",
      "content/**/*",
      "intro.mp4",
      "intro2.mp4",
      "56x56-Logo.png",
      "icono.ico",
      "package.json"
    ],
    "win": {
      "icon": "icono.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "extraFiles": [
      {
        "from": "icono.ico",
        "to": "icono.ico"
      }
    ],
    "nsis": {
      "include": "build/installer.nsh",
      "installerIcon": "icono.ico",
      "uninstallerIcon": "icono.ico",
      "installerHeaderIcon": "icono.ico",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Obsidian Studios Launcher"
    },
    "publish": {
      "provider": "github",
      "owner": "Pizzha541",
      "repo": "ObsidianStudiosLauncher",
      "releaseType": "release"
    }
  },
  "devDependencies": {
    "electron": "^42.11.18",
    "electron-builder": "^26.18.0"
  },
  "dependencies": {
    "adm-zip": "^0.6.1",
    "axios": "^1.21.1",
    "electron-updater": "^6.8.11",
    "fflate": "^0.8.3",
    "minecraft-launcher-core": "^3.18.2",
    "msmc": "^5.0.5",
    "skinview3d": "^3.4.2"
  },
  "overrides": {
    "fflate": "$fflate",
    "minecraft-launcher-core": {
      "adm-zip": "0.6.1"
    }
  }
}
